<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <!-- sharedpref 与设备凭据都不能进云备份/换机迁移。 -->
  <cloud-backup>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="relay-credentials.bin" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="relay-credentials.bin" />
  </device-transfer>
</data-extraction-rules>